# Server history (photos, SQLite). Anchored to the repo root: on Windows and macOS git ignores case,
# so a plain "data/" would also hide models/ShelfCountModel.mlpackage/Data/.
/data/
/runs/
.venv/
__pycache__/
*.pt
ios/ShelfCount.xcodeproj/
ios/Generated/
ios/ShelfCount/Info.plist
ios/build.log
node_modules/
ios/resolve.log
ios/git-check.log
